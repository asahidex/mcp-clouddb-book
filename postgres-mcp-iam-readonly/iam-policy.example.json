{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsReadOnlyDbUser",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:ap-northeast-1:<account-id>:dbuser:<cluster-resource-id>/mcp_readonly"
    },
    {
      "Sid": "ReadUserNameSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-northeast-1:<account-id>:secret:cbsr2/mcp_readonly-??????"
    },
    {
      "Sid": "ServerStartupClusterCheck",
      "Effect": "Allow",
      "Action": "rds:DescribeDBClusters",
      "Resource": "arn:aws:rds:ap-northeast-1:<account-id>:cluster:cbsr2-iam"
    }
  ]
}
